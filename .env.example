APP_NAME=legal-desk-assistance
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=legal-desk-assistance
DB_USERNAME=legal-desk-assistance
DB_PASSWORD=
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# SMTP email delivery (replace placeholders with your provider settings)
# For local development without sending email, use MAIL_MAILER=log.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.example.test
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.test
MAIL_FROM_NAME="${APP_NAME}"
# Port 587 normally uses STARTTLS; for implicit TLS on port 465 use MAIL_SCHEME=smtps.

# AI Search and provider configuration
AI_SEARCH_LOCATION=Malaysia
AI_MANAGEMENT_PROVIDER=openai
AI_MANAGEMENT_MODEL=gpt-4o-mini
AI_CASE_ASSISTANT_ENABLED=true
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Optional second provider; DeepSeek does not supply the OpenAI web_search tool
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

DOCUMENT_SCAN_ENABLED=false
DOCUMENT_SCAN_BINARY=/usr/bin/clamscan
DOCUMENT_SCAN_TIMEOUT=60

# Case correspondence quotas (fixed UTC windows; zero blocks new sends)
CASE_EMAIL_USER_MINUTE=5
CASE_EMAIL_USER_DAILY=50
CASE_EMAIL_FIRM_DAILY=500

LOGIN_AUDIT_RETENTION_DAYS=90
