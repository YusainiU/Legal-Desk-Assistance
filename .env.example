APP_NAME=legal-desk-assistance
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=legal-desk-assistance
DB_USERNAME=legal-desk-assistance
DB_PASSWORD=
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.test
MAIL_FROM_NAME="${APP_NAME}"

# AI Search and provider configuration
AI_SEARCH_LOCATION=Malaysia
AI_MANAGEMENT_PROVIDER=openai
AI_MANAGEMENT_MODEL=gpt-4o-mini
AI_CASE_ASSISTANT_ENABLED=true
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Optional second provider; DeepSeek does not supply the OpenAI web_search tool
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
