{
  "name": "yusainiu/legal-desk-assistance",
  "type": "project",
  "description": "A legal desk assistance application built with Laravel and Livewire",
  "license": "GPL v3",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.0",
    "livewire/livewire": "^4.0",
    "laravel/fortify": "^1.43",
    "livewire/flux": "^2.21",
    "laravel/tinker": "^3.2",
    "simplydigital/legal-desk-law-resources": "@dev",
    "simply-digital/laravel-rich-editor": "dev-main",
    "ezyang/htmlpurifier": "^4.18"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "npx concurrently -c \"#93c5fd,#c4b5fd\" \"php artisan serve\" \"npm run dev\" --names=server,vite --kill-others"
    ]
  },
  "repositories": [
    {
      "type": "path",
      "url": "packages/Simplydigital/legal-desk-law-resources",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "vcs",
      "url": "https://github.com/YusainiU/Rich-HTML-Editor"
    }
  ],
  "require-dev": {
    "phpunit/phpunit": "^13.4",
    "fakerphp/faker": "^1.24"
  }
}
