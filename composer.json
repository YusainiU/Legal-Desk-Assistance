{
  "name": "yusainiu/legal-desk-assistance",
  "type": "project",
  "description": "A legal desk assistance application built with Laravel and Livewire",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.0",
    "livewire/livewire": "^4.0",
    "laravel/fortify": "^1.43",
    "livewire/flux": "^2.21",
    "laravel/tinker": "^3.2"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "npx concurrently -c \"#93c5fd,#c4b5fd\" \"php artisan serve\" \"npm run dev\" --names=server,vite --kill-others"
    ]
  }
}
